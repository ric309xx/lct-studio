{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "lct-private-3d-viewer",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "lct-3d-models"
    }
  ]
}
