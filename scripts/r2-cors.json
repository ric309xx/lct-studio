{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:5173",
          "http://127.0.0.1:5173",
          "http://localhost:5500",
          "http://127.0.0.1:5500",
          "https://lctstudio.tw",
          "https://www.lctstudio.tw"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "Content-Type"]
      },
      "exposeHeaders": ["Accept-Ranges", "Content-Length", "Content-Range", "ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
